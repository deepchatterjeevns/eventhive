# Copy to .env and adjust for your environment.
# IMPORTANT: auth_service and booking_service MUST share JWT_SIGNING_KEY,
# otherwise tokens minted by the auth service cannot be verified by bookings.

# Use the same value in both services locally. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-random-secret
JWT_SIGNING_KEY=replace-me-with-a-shared-jwt-signing-secret

DEBUG=True

# Comma-separated. The test client needs "testserver".
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,eventhive.local,auth,booking,auth_service,booking_service

DB_NAME=eventhive_db
DB_USER=root
DB_PASSWORD=rootpassword
DB_HOST=127.0.0.1
DB_PORT=3306
